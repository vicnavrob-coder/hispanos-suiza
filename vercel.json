{
  "buildCommand": "TURBOPACK=0 next build",
  "framework": "nextjs",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/suiza-starter-pack/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-newsletter",
      "schedule": "0 9 * * 4"
    }
  ]
}
